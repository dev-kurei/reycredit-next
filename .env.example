# Copy the names below into Vercel with:  vercel env add NAME production
# (for the one-time data import, also put the first two in a local file called .env.local)

# Supabase  ->  Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # the "service_role" key, NOT the "anon" key. Never share it.

# Random secrets — generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CRON_SECRET=

# Resend (sends the app's email)  ->  resend.com -> API Keys
# Verify your domain first under resend.com -> Domains -> Add, then add the
# DNS records Resend shows you (separate from Zoho Mail's MX records -- the
# two can both point at reycredits.com without conflict).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=billing@reycredits.com
